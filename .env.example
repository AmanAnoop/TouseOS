# ── Supabase ────────────────────────────────────────────────
# From Supabase → Settings → API (same project for both lines)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# PUBLIC key only — anon (legacy JWT eyJ...) OR publishable (sb_publishable_...)
# NEVER put service_role here (causes "Invalid API key" in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias if using new Supabase publishable keys:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to false to disable Connect onboarding UI
STRIPE_CONNECT_ENABLED=true
# Optional platform fee % on destination charges (e.g. 2.9)
PLATFORM_STRIPE_APPLICATION_FEE_PERCENT=2.9

# ── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.touseos.com
NEXTAUTH_SECRET=your-secret-at-least-32-chars

# Comma-separated emails with multi-tenant platform admin access
PLATFORM_ADMIN_EMAILS=you@example.com
PLATFORM_IMPERSONATION_ENABLED=true
# Optional JSON map: {"greekmatch":true,"interchapter":true}
PLATFORM_FEATURE_FLAGS=

# Campus recreation / Greek life office (read-only org oversight)
UNIVERSITY_ADMIN_EMAILS=admin@university.edu
UNIVERSITY_ADMIN_CAMPUSES=State University

# ── Resend (email) ──────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=TouseOS <updates@yourdomain.com>

# OpenAI (AI assistant)
OPENAI_API_KEY=sk-...

# Vercel Cron — protect /api/cron/* routes
CRON_SECRET=your-random-cron-secret

# Web Push (optional — generate with web-push library)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com
