# Copy to .env.local and fill in values. Never commit .env.local.
# Prefer one file for all keys: cp config/keys/keys.env.example config/keys/keys.env

# ── Clerk (auth + organizations) ───────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# After sign-in / sign-up (optional — defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/home
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Supabase (database + storage; session when Clerk bridge disabled) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe Connect ─────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=true
PLATFORM_STRIPE_APPLICATION_FEE_PERCENT=2.9

# ── Plaid (read-only chapter bank) ─────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# ── Mapbox (maps + geocoding) ──────────────────────────────
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# ── Radar (geofencing / check-in verification) ─────────────
NEXT_PUBLIC_RADAR_PUBLISHABLE_KEY=
RADAR_SECRET_KEY=

# ── Anthropic (AI assistant — server only) ─────────────────
ANTHROPIC_API_KEY=

# ── Twilio ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=

PLATFORM_ADMIN_EMAILS=
PLATFORM_IMPERSONATION_ENABLED=true
PLATFORM_FEATURE_FLAGS=

UNIVERSITY_ADMIN_EMAILS=
UNIVERSITY_ADMIN_CAMPUSES=

# ── Resend ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Legacy OpenAI route (optional if using Anthropic)
OPENAI_API_KEY=

CRON_SECRET=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com
