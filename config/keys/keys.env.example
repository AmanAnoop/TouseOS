# Copy to keys.env and fill in values. Never commit keys.env.
# All keys load server-side via next.config.ts — secrets never go in client code.

# ── Supabase (required) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Client-safe publishable key only (sb_publishable_... or legacy eyJ anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ── App (required) ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# ── Stripe Connect ─────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=true
PLATFORM_STRIPE_APPLICATION_FEE_PERCENT=0.25

# ── Twilio (SMS) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ── Anthropic Claude (all AI features) ─────────────────────
ANTHROPIC_API_KEY=

# ── Resend (email blasts) ──────────────────────────────────
# Free tier: sign up at resend.com → API Keys. For testing without a domain,
# leave RESEND_FROM_EMAIL empty — app uses onboarding@resend.dev (Resend sandbox).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Mapbox (optional) ──────────────────────────────────────
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# ── Plaid (optional) ───────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Platform admin ─────────────────────────────────────────
PLATFORM_ADMIN_EMAILS=
